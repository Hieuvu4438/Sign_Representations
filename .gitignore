__pycache__/
*.pyc
.venv*/
# Vendor upstream source, but keep nested repository metadata local.
/third_party/**/.git
/artifacts/legacy/third_party
artifacts/runtime/
/artifacts/legacy/checkpoints/
/artifacts/legacy/features/
/artifacts/legacy/**/features/
artifacts/legacy/evidence/papers/*.pdf
artifacts/legacy/evidence/papers/*.txt
*.partial

# Local credentials and editor/runtime caches.
.env
.env.*
!.env.example
*.pem
*.key
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.lock

# Downloaded media, publications, archives and generated tensor artifacts.
# Keep their provenance, checksums, protocols and textual reports in Git.
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.pdf
*.zip
*.tar
*.tar.gz
*.pt
*.pth
*.bin
*.safetensors
*.npy
*.npz
logs/
artifacts/legacy/evidence/**/logs/

# Full dataset inventories are regenerated by scripts/build_manifests.py.
# Small locked cohorts, exclusions and split metadata remain versioned.
artifacts/legacy/data/manifests/all.jsonl
artifacts/legacy/data/manifests/isolated.jsonl
artifacts/legacy/data/manifests/asl_citizen.jsonl
artifacts/legacy/data/manifests/how2sign.jsonl
