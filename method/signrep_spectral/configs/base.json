  },
  "checkpoint_sha256": "f8be8ca44aec4d7066175dccc681338f376ec86de6ba72bc79223a6bbd3c766b",
  "data": {
    "dataset": "ASL_Citizen",
    "train_split": "train",
    "clip_length": 16,
    "sampling": "uniform_video_then_start",
