{
  "schema_version": "signrep_spectral_config_v1",
  "mode": "canonical_continuation_v1",
  "arm_id": "",
  "paths": {
    "vendor_root": "third_party/SignRep",
    "checkpoint": "checkpoints/signrep/ckpt.pt",
    "dataset_root": null,
    "manifest": null,
    "scaler": null,
