# Regenerable tensors, feature inventories, dataset caches and process logs.
# Keep experiment configurations, training traces and evaluation reports in Git.
runtime/cache/
runtime/feats/
runtime/logs/
runtime/schedule_state.json
runtime/launch/*.log
runtime/eval/**/train.jsonl
runtime/eval/**/test.jsonl
runtime/eval/**/progress.json

# Continuation feature shards and supervisor output are regenerated locally.
# Preserve pinned inputs, source snapshots, training traces and final reports.
runtime/plctx160_continuation/**/feature_cache/
runtime/plctx160_continuation/service.log
